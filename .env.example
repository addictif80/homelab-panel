# Secret used to sign session/2FA JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Master secret for the credential vault (SSH keys, API tokens). Generate with: openssl rand -hex 32
# Never reuse SESSION_SECRET here, and never commit the real value.
VAULT_MASTER_KEY=

# Optional: custom salt for the vault key derivation. Change only on a fresh install.
VAULT_KDF_SALT=homelab-panel-vault

# Where the SQLite database (data/panel.db) is stored. Defaults to ./data
DATA_DIR=./data
